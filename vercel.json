{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/dashboard(\\.html)?",
      "dest": "/#dashboard"
    },
    {
      "src": "/login(\\.html)?",
      "dest": "/#login"
    },
    {
      "src": "/signup(\\.html)?",
      "dest": "/#signup"
    },
    {
      "src": "/qr(-code)?(\\.html)?",
      "dest": "/#qr"
    },
    {
      "src": "/bio(-pages)?(\\.html)?",
      "dest": "/#pages"
    },
    {
      "src": "/analytics(\\.html)?",
      "dest": "/#analytics"
    },
    {
      "src": "/pricing(\\.html)?",
      "dest": "/#pricing"
    },
    {
      "src": "/solutions(\\.html)?",
      "dest": "/#solutions"
    },
    {
      "src": "/ai(\\.html)?",
      "dest": "/#assist"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
