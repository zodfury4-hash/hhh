{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node tools/build_pages.js",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,public/**,pages/**,partials/**,css/**,js/**,locales/**,content/**,app.html}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
