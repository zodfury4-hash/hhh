# ========================================================
# HEA Link Full-Stack Environment Configuration Template
# DO NOT ADD REAL SECRETS TO THIS FILE. USE DUMMY VALUES.
# ========================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# Primary Database: MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/healink
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/healink?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_string

# Admin Seed Account (One-time DB initialization)
ADMIN_EMAIL=admin@healink.store
ADMIN_PASSWORD=change_this_admin_password_in_production

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://www.healink.store

# Nodemailer SMTP Email Configuration (For Email Verification & Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="HEA Link <noreply@healink.store>"

# Google OAuth Single Sign-On (Client ID for Frontend Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Stripe Payment & Billing Gateway
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Optional: Google Safe Browsing API Key (For URL abuse checks)
GOOGLE_SAFE_BROWSING_KEY=

# Firebase Realtime Database (Deprecated / Disabled by default)
ENABLE_FIREBASE_RTDB=false
FIREBASE_DATABASE_URL=https://healinks-4ea4d-default-rtdb.firebaseio.com
